# Local testing defaults to a local PostgreSQL database. Override with the Neon
# connection string (or a local PostgreSQL) to use a hosted database.
APP_ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duesdesk

# Live deployment (Render + Neon PostgreSQL): set APP_ENV=production and keep the
# following as host secret settings. Never commit real values.
# DJANGO_SECRET_KEY=<random 64+ character secret>
# ALLOWED_HOSTS=dues.your-domain.com,duesdesk.onrender.com
# CSRF_TRUSTED_ORIGINS=https://dues.your-domain.com,https://duesdesk.onrender.com
# DATABASE_URL=<Neon pooled connection string, kept private>
# EMAIL_HOST=<SMTP server>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<SMTP username>
# EMAIL_HOST_PASSWORD=<SMTP secret>
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Duesdesk <noreply@your-domain.com>
# BIND_HOST=0.0.0.0
# PORT=8000
# TRUST_PROXY=1
# TRUSTED_PROXY_IP=*
# Use * only when the host blocks direct access and its edge strips/replaces forwarded headers.
# Duesdesk authenticates with a username and password only. There is no external
# identity provider, so no OAuth client id or secret is read or required.
# Email verification uses SMTP by default, including local runs; never log codes.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Tests override this with Django's in-memory email backend.

# Optional HTTPS email delivery for Render Free (no new Render service):
# RESEND_API_KEY=<sending-only API key, keep secret>
# DEFAULT_FROM_EMAIL=Duesdesk <noreply@your-verified-domain.com>
# Setting RESEND_API_KEY selects the HTTPS backend unless EMAIL_BACKEND overrides it.
