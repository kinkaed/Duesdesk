# Local Windows testing defaults to FinancialSecretaryTest using your Windows account.
APP_ENV=local
DB_HOST=localhost
DB_NAME=FinancialSecretaryTest
DB_AUTH=windows

# Live deployment: set APP_ENV=production and replace all placeholders in the host's secret settings.
# DJANGO_SECRET_KEY=<random 64+ character secret>
# ALLOWED_HOSTS=dues.your-domain.com,your-app.azurewebsites.net
# CSRF_TRUSTED_ORIGINS=https://dues.your-domain.com,https://your-app.azurewebsites.net
# DB_HOST=your-server.database.windows.net
# DB_NAME=DuesdeskLive
# DB_PORT=1433
# DB_AUTH=managed_identity
# Or DB_AUTH=sql with DB_USER and DB_PASSWORD, stored as host secrets.
# DB_USER=<runtime database user>
# DB_PASSWORD=<secret>
# EMAIL_HOST=<SMTP server>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<SMTP username>
# EMAIL_HOST_PASSWORD=<SMTP secret>
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Duesdesk <noreply@your-domain.com>
# BIND_HOST=0.0.0.0
# PORT=8000
# TRUST_PROXY=1
# TRUSTED_PROXY_IP=*
# Use * only when the host blocks direct access and its edge strips/replaces forwarded headers.
